# Root .gitignore for MERN Project

# Dependencies
node_modules/
package-lock.json
yarn.lock

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build & Production
/build
/dist
dist-ssr/

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing
/coverage
.nyc_output/

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Temporary Files
*.tmp
*.temp
tmp/

# Editor Directories
.vscode
.idea
*.code-workspace

# Backend Specific
backend/uploads/*
!backend/uploads/.gitkeep

# Frontend Specific
frontend/dist/
frontend/build/
frontend/.cache/
